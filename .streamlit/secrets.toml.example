# Copy to .streamlit/secrets.toml for local testing (that file is gitignored),
# or paste these keys into the Streamlit Cloud app under Settings -> Secrets.
# Every key is OPTIONAL: with none set, the app runs open and ledger-local,
# exactly as it does on the Mac today.

# --- Password gate -----------------------------------------------------------
# Protects the public URL. Leave unset to run without a password.
password = "choose-a-strong-password"

# --- Ledger persistence (survive Streamlit Cloud redeploys) ------------------
# The cloud filesystem is ephemeral, so logged bets are lost on redeploy
# unless mirrored off-box. We mirror the ledger to a PRIVATE GitHub gist.
#
# Setup:
#   1. Create a secret gist at https://gist.github.com with one file named
#      exactly  paper_ledger.csv  (paste your current ledger as its contents).
#   2. Copy the gist id from its URL (the long hash).
#   3. Create a token with the "gist" scope:
#      https://github.com/settings/tokens  (classic, "gist" checkbox), or a
#      fine-grained token with Gists access.
#   4. Fill both values below. Leave blank to keep the ledger local only.
github_token = ""
gist_id = ""
